        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "item"
      ],
      "title": "PatternSummaryResponse",
      "type": "object"
    },
    "SloThresholds": {
      "additionalProperties": false,
      "properties": {
        "maximum_estimated_variable_cost": {
          "minimum": 0,
          "title": "Maximum Estimated Variable Cost",
          "type": "number"
        },
        "maximum_latency_p95_ms": {
          "minimum": 0,
          "title": "Maximum Latency P95 Ms",
          "type": "number"
        },
        "minimum_quality": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Quality",
          "type": "number"
        },
        "minimum_security_pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Security Pass Rate",
          "type": "number"
        },
        "minimum_success_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Success Rate",
          "type": "number"
        }
      },
      "required": [
        "minimum_quality",
        "maximum_latency_p95_ms",
        "minimum_success_rate",
        "minimum_security_pass_rate",
        "maximum_estimated_variable_cost"
      ],
      "title": "SloThresholds",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-only wrapper used to generate frontend transport types.",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/CapabilityResponse"
    },
    "comparison": {
      "$ref": "#/$defs/ComparisonResponse"
    },
    "decision": {
      "$ref": "#/$defs/DecisionResponse"
    },
    "experiments": {
      "$ref": "#/$defs/ExperimentListResponse"
    },
    "native_link": {
      "$ref": "#/$defs/NativeLinkResponse"
    },
    "pattern_summary": {
      "$ref": "#/$defs/PatternSummaryResponse"
    }
  },
  "required": [
    "capabilities",
    "experiments",
    "comparison",
    "pattern_summary",
    "native_link",
    "decision"
  ],
  "title": "BenchmarkApiContract",
  "type": "object"
}
