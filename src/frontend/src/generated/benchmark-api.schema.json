    "CapabilityResponse": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_version",
        "capabilities"
      ],
      "title": "CapabilityResponse",
      "type": "object"
    },
    "ComparisonResponse": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/ExperimentSummary"
        },
        "candidate": {
          "$ref": "#/$defs/ExperimentSummary"
        },
        "compatible_scope": {
          "title": "Compatible Scope",
          "type": "boolean"
        },
        "deltas": {
          "additionalProperties": {
            "$ref": "#/$defs/Delta"
          },
          "title": "Deltas",
          "type": "object"
        },
        "incompatibility_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Incompatibility Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "baseline",
        "candidate",
        "compatible_scope",
        "deltas"
      ],
      "title": "ComparisonResponse",
      "type": "object"
    },
    "DecisionEvidence": {
      "additionalProperties": false,
      "properties": {
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "on_pareto_frontier": {
          "title": "On Pareto Frontier",
          "type": "boolean"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "publication_blockers": {
          "items": {
            "type": "string"
          },
          "title": "Publication Blockers",
          "type": "array"
        },
        "publication_ready": {
          "title": "Publication Ready",
          "type": "boolean"
        },
        "qualification_failures": {
          "items": {
            "type": "string"
          },
          "title": "Qualification Failures",
          "type": "array"
        },
        "qualified": {
          "title": "Qualified",
          "type": "boolean"
        }
      },
      "required": [
        "experiment_id",
        "pattern",
        "qualified",
        "on_pareto_frontier",
        "publication_ready"
      ],
      "title": "DecisionEvidence",
      "type": "object"
    },
    "DecisionResponse": {
      "additionalProperties": false,
      "properties": {
        "available_scopes": {
          "items": {
            "$ref": "#/$defs/DecisionScope"
          },
          "title": "Available Scopes",
          "type": "array"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/DecisionEvidence"
          },
          "title": "Evidence",
          "type": "array"
