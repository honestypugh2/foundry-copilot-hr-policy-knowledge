        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "release_status": {
          "title": "Release Status",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_configured",
            "not_authorized",
            "not_applicable",
            "degraded"
