          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "name",
        "classification",
        "status",
        "implementation_status",
        "release_status",
        "source_version",
        "authoritative_system"
      ],
      "title": "Capability",
      "type": "object"
