        "latency_p99_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency P99 Ms"
        },
        "model_deployment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Deployment"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "retrieval_mode": {
          "title": "Retrieval Mode",
          "type": "string"
        },
        "sample_warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
