        "classification": {
          "enum": [
            "reuse",
            "adapter",
            "new_gap_coverage"
          ],
          "title": "Classification",
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "configuration_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Source"
        },
        "deep_link_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deep Link Type"
        },
        "freshness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness"
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "partial",
            "external_reference"
