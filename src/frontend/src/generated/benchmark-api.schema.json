        "goal": {
          "enum": [
            "quality",
            "balanced",
            "speed"
          ],
          "title": "Goal",
          "type": "string"
        },
        "leading_experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leading Experiment Id"
        },
        "leading_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leading Reason"
        },
        "recommended_experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Experiment Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Scope"
        },
        "selection_method": {
          "title": "Selection Method",
          "type": "string"
        },
        "thresholds": {
          "$ref": "#/$defs/SloThresholds"
        }
      },
      "required": [
        "goal",
        "thresholds",
        "selection_method"
      ],
      "title": "DecisionResponse",
      "type": "object"
    },
    "DecisionScope": {
      "additionalProperties": false,
      "properties": {
        "experiment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Experiment Ids",
          "type": "array"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "scope_id",
        "experiment_ids"
      ],
      "title": "DecisionScope",
      "type": "object"
    },
    "Delta": {
      "additionalProperties": false,
      "properties": {
        "absolute": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute"
        },
        "caveat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caveat"
        },
        "comparable": {
          "default": true,
          "title": "Comparable",
          "type": "boolean"
        },
        "relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative"
        }
      },
      "title": "Delta",
      "type": "object"
    },
    "ExperimentListResponse": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ExperimentSummary"
          },
          "title": "Items",
          "type": "array"
