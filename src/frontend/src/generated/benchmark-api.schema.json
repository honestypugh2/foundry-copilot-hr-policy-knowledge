      "required": [
        "resource_type",
        "source_id",
        "status",
        "release_status"
      ],
      "title": "NativeLinkResponse",
      "type": "object"
    },
    "PatternEvidence": {
      "additionalProperties": false,
      "properties": {
        "automation_boundary": {
          "title": "Automation Boundary",
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "measured",
            "fixture_only",
            "run_required"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "experiment_count": {
          "minimum": 0,
          "title": "Experiment Count",
          "type": "integer"
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "partial"
