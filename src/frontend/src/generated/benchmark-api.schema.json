        "pattern": {
          "enum": [
            "A",
            "A2",
            "B",
            "C",
            "Hosted"
          ],
          "title": "Pattern",
          "type": "string"
        },
        "telemetry_boundary": {
          "title": "Telemetry Boundary",
          "type": "string"
        }
