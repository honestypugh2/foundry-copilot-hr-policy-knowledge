          "default": null,
          "title": "Authoritative Url"
        },
        "release_status": {
          "title": "Release Status",
          "type": "string"
        },
        "resource_type": {
          "title": "Resource Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_configured",
            "not_authorized",
            "not_applicable",
            "degraded"
