/// Contiguous seven-day synthetic demonstration period, October 22-28, 2026.
table Calendar
	lineageTag: 66f4ea8a-3be4-4ef3-adf4-6c5591805525

	/// Synthetic fixture date, never a live refresh/collection timestamp.
	measure 'Evidence Date' = FORMAT(MAX('Calendar'[Date]), "yyyy-MM-dd") & " | SYNTHETIC"
		formatString: @
		lineageTag: dc233608-0580-4d2c-8657-edaab10604ba

	/// Synthetic observation date, not the time of a live service collection.
	column Date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 343021bf-9baa-4061-9ad8-ebad9e31a7d9
		sourceColumn: Date

	partition Calendar = m
		mode: import
		source = let Source = Table.FromList(List.Dates(#date(2026,10,22),7,#duration(1,0,0,0)), Splitter.SplitByNothing(), {"Date"}), Typed = Table.TransformColumnTypes(Source,{{"Date",type date}}) in Typed
