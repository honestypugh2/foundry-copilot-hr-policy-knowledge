{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourcePrefix": {
      "value": "hr-policy-kb"
    },
    "openAIDeploymentName": {
      "value": "gpt-5-mini"
    },
    "gpt5DeploymentName": {
      "value": "gpt-5"
    },
    "embeddingDeploymentName": {
      "value": "text-embedding-3-small"
    },
    "searchKnowledgeSourceName": {
      "value": "${AZURE_SEARCH_KNOWLEDGE_SOURCE_NAME=hr-knowledge-source}"
    },
    "searchKnowledgeBaseName": {
      "value": "${AZURE_SEARCH_KNOWLEDGE_BASE_NAME=hr-knowledge-base}"
    },
    "searchKnowledgeBaseModelDeployment": {
      "value": "${AZURE_SEARCH_KB_MODEL_DEPLOYMENT=gpt-5-mini}"
    },
    "searchKnowledgeBaseReasoningEffort": {
      "value": "${AZURE_SEARCH_KB_REASONING_EFFORT=medium}"
    },
    "searchKnowledgeBaseOutputMode": {
      "value": "${AZURE_SEARCH_KB_OUTPUT_MODE=extractiveData}"
    },
    "searchMcpApiVersion": {
      "value": "${AZURE_SEARCH_MCP_API_VERSION=2026-05-01-preview}"
    },
    "searchSku": {
      "value": "basic"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "hostedAgentPrincipalId": {
      "value": "${AZURE_HOSTED_AGENT_PRINCIPAL_ID=}"
    },
    "backendAuthClientId": {
      "value": "${AZURE_BACKEND_AUTH_CLIENT_ID=}"
    },
    "searchLocation": {
      "value": "${AZURE_SEARCH_LOCATION=}"
    },
    "backendImage": {
      "value": "${AZURE_BACKEND_IMAGE=}"
    }
  }
}
